spring.application.name=retail_inventory

# Database Configuration (MySQL / TiDB Cloud)
spring.datasource.url=jdbc:mysql://<HOST>:<PORT>/retail_inventory?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8
spring.datasource.username=<USERNAME>
spring.datasource.password=<PASSWORD>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Server
server.port=${PORT:8080}

# JWT Configuration
jwt.secret=${JWT_SECRET:defaultDevelopmentSecretKeyChangeThisImmediately123456789}
jwt.expiration=86400000
